{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mobile-audit:research-report:1.0",
  "title": "Mobile Audit unified research report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "generated_at",
    "target",
    "environment",
    "inputs",
    "visibility",
    "coverage",
    "evidence",
    "leads",
    "dependencies",
    "known_advisories",
    "assessment",
    "llm_reviews",
    "static_warnings",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "research-1.0"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "mobile-audit"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "platform",
        "identifier",
        "name",
        "version"
      ],
      "properties": {
        "platform": {
          "const": "ios"
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "ios_version"
      ],
      "properties": {
        "ios_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sha256",
          "hash_scope",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "hash_scope": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "visibility": {
      "type": "object"
    },
    "package_profile": {
      "type": "object",
      "description": "Bounded iOS package inventory when an IPA or app bundle was supplied. Declarations and binary metadata are observations, not verified vulnerabilities."
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "status",
          "detail"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "limited",
              "unavailable"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source_id",
          "locator",
          "summary",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "priority",
          "confidence",
          "state",
          "evidence_ids",
          "attacker_control",
          "possible_impact",
          "next_test",
          "remediation_if_confirmed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "state": {
            "enum": [
              "hypothesis",
              "static_lead",
              "researcher_recorded",
              "researcher_reported_impact",
              "known_version_match",
              "llm_suggestion"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "attacker_control": {
            "type": "string"
          },
          "possible_impact": {
            "type": "string"
          },
          "attack_scenario": {
            "type": "string"
          },
          "path_analysis": {
            "$ref": "#/$defs/path_analysis"
          },
          "next_test": {
            "type": "string"
          },
          "disconfirming_result": {
            "type": "string"
          },
          "remediation_if_confirmed": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "path_analysis"
              ]
            },
            "then": {
              "properties": {
                "state": {
                  "const": "hypothesis"
                },
                "confidence": {
                  "const": "low"
                }
              }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "known_advisories": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "status",
        "grade",
        "coverage_percent",
        "evidence_strength",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "incomplete",
            "provisional"
          ]
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "F",
            null
          ]
        },
        "coverage_percent": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence_strength": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "llm_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "hypothesis_count",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "hypothesis_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "unreviewed"
          }
        }
      }
    },
    "static_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "path_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "clues",
        "missing_link"
      ],
      "properties": {
        "basis": {
          "const": "co_presence_only"
        },
        "clues": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "evidence_ids"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "missing_link": {
          "type": "string"
        }
      }
    }
  }
}
